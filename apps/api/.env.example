DATABASE_URL="mysql://attendance:password@127.0.0.1:3306/attendance_bonus?charset=utf8mb4"
# 中国网络环境下载 Prisma 引擎失败时使用；可删除以恢复官方源。
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
MAIL_TARGET="archive@example.com"
LOCAL_EMAIL_MODE=false
MAIL_SIGNING_SECRET="replace-with-a-random-secret-at-least-32-characters"
ADMIN_ACCOUNT="admin"
ADMIN_PASSWORD="replace-with-initial-admin-password"
PORT=3000
# Keep the local edition private to this computer. Use 0.0.0.0 only when
# intentionally exposing the API on a trusted network or production host.
HOST="127.0.0.1"
UPLOAD_DIR="./uploads"
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="sender@example.com"
SMTP_PASS="replace-with-app-password"
SMTP_FROM="返校打卡 <sender@example.com>"
IMAP_HOST="imap.example.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER="archive@example.com"
IMAP_PASS="replace-with-app-password"
IMAP_PROCESSED_MAILBOX="Processed"
