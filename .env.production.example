# DOMAIN 不带 https://；两个数据库密码请使用不同的随机字母数字，避免 URL 转义问题。
DOMAIN=checkin.your-school.example
DB_PASSWORD=replace_with_random_alphanumeric_password
DB_ROOT_PASSWORD=replace_with_different_random_alphanumeric_password
MAIL_SIGNING_SECRET=replace_with_at_least_32_random_characters
MAIL_TARGET=archive@your-school.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@your-school.example
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=sender@your-school.example
IMAP_HOST=imap.your-provider.example
IMAP_PORT=993
IMAP_USER=archive@your-school.example
IMAP_PASS=replace_with_imap_app_password
# 仅初始化时临时设置，成功创建后删除 ADMIN_PASSWORD。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=replace_with_initial_admin_password
